# Copy to .env only for real integrations. Demo and tests need no credentials.
DATABASE_URL=sqlite:///vendor_ai.db
SQL_ECHO=false
OPENAI_API_KEY=
SAM_API_KEY=
APOLLO_API_KEY=
SERPER_API_KEY=
HUNTER_API_KEY=
GOOGLE_MAPS_API_KEY=
ENABLE_AUTO_INGESTION=true
SMART_LLM_MODEL=gpt-5.1
CHEAP_LLM_MODEL=gpt-5-mini
VISION_LLM_MODEL=gpt-5-mini
USE_FLEX_TIER=true

# Original dashboard login (not needed for CLI/demo)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_REDIRECT_URI=http://localhost:8501
ALLOWED_EMAILS=
AUTH_COOKIE_SECRET=
AUTH_SESSION_COOKIE_SECURE=true
