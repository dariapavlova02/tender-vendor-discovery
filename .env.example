# OpenAI API Key (Required for LLM features)
OPENAI_API_KEY=sk-your-openai-api-key-here

# LangSmith Tracing (Optional - for debugging LLM calls)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=ls-your-langsmith-key-here
LANGCHAIN_PROJECT=vendor-agent

# Database Configuration (Required for vendor discovery)
# SQLite (default - no installation needed):
DATABASE_URL=sqlite:///vendor_ai.db
# PostgreSQL (for production):
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/vendor_ai
SQL_ECHO=false

# External APIs (Optional)
SAM_API_KEY=your-sam-gov-api-key
APOLLO_API_KEY=your-apollo-api-key
HUNTER_API_KEY=your-hunter-api-key
GOOGLE_MAPS_API_KEY=your-google-maps-api-key
SERPER_API_KEY=your-serper-api-key

# Pipeline Configuration
ENABLE_AUTO_INGESTION=true

# LLM Model Configuration
# DEFAULT_LLM_MODEL applies to cheap_model if CHEAP_LLM_MODEL not set
DEFAULT_LLM_MODEL=gpt-5-mini
# Individual model overrides (optional)
SMART_LLM_MODEL=gpt-5.1
CHEAP_LLM_MODEL=gpt-5-mini
VISION_LLM_MODEL=gpt-5-mini
USE_FLEX_TIER=true
